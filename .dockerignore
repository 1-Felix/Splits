# VCS / CI
.git
.github

# dependencies (reinstalled in the image)
node_modules
.venv
venv
__pycache__
*.pyc

# personal data + secrets — must NEVER bake into the image (they live in /data)
.env
.garmin_tokens
.garmin_cache
garmin-data.js
plan-data.js
activity-archive.db*
coach-briefing.md

# dev-only / not needed at runtime (plan-dump.mjs IS runtime: the sync's
# compliance step reads the plan through it)
openspec
docs
tools
!tools/plan-dump.mjs
test_*.py
test_*.mjs
fixtures
*.md
.playwright-mcp
.claude
.idea
.vscode
.DS_Store
Thumbs.db
splits-*.png

# NB: vendor/ (React UMD builds, self-hosted woff2 fonts, the PWA icons) is
# deliberately NOT ignored — it is application code and MUST ship in the image
# so the cockpit renders with outbound network access removed. Do not add
# vendor/ here. manifest.webmanifest is likewise application code: the app is
# not installable without it, and `splits-*.png` above is root-relative on
# purpose, so vendor/icons/*.png ships (they are named icon-*.png regardless,
# because .gitignore's splits-*.png DOES match at any depth).
